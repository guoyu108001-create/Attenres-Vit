@@ -0,0 +1,34 @@
+"""Stream-extract ILSVRC2012_img_train.tar (1000 per-class tars) from the NAS straight into
+<dst>/<wnid>/<file>.JPEG on local disk: one sequential NAS read, no intermediate tar files.
+
+Usage: python scripts/data/extract_imagenet_train.py <ILSVRC2012_img_train.tar> <dst train dir>
+Prints progress every 50 classes and a final "DONE ..." line (~80 MiB/s from the NAS on 147).
+"""
+import os
+import shutil
+import sys
+import tarfile
+import time
+
+src, dst = sys.argv[1], sys.argv[2]
+os.makedirs(dst, exist_ok=False)
+t0, n_cls, n_img, n_bytes = time.time(), 0, 0, 0
+with tarfile.open(src, mode="r|") as outer:
+    for member in outer:
+        if not (member.isfile() and member.name.endswith(".tar")):
+            continue
+        wnid = os.path.basename(member.name)[: -len(".tar")]
+        os.makedirs(os.path.join(dst, wnid))
+        with tarfile.open(fileobj=outer.extractfile(member), mode="r|") as inner:
+            for im in inner:
+                if not im.isfile():
+                    continue
+                with inner.extractfile(im) as fin, open(os.path.join(dst, wnid, os.path.basename(im.name)), "wb") as fout:
+                    shutil.copyfileobj(fin, fout, 1 << 20)
+                n_img += 1
+                n_bytes += im.size
+        n_cls += 1
+        if n_cls % 50 == 0:
+            dt = time.time() - t0
+            print(f"{n_cls} classes, {n_img} images, {n_bytes / 2**30:.1f} GiB, {dt / 60:.1f} min, {n_bytes / 2**20 / dt:.0f} MiB/s", flush=True)
+print(f"DONE {n_cls} classes, {n_img} images, {n_bytes / 2**30:.1f} GiB in {(time.time() - t0) / 60:.1f} min", flush=True)
diff --git a/scripts/data/switch_to_local_data.sh b/scripts/data/switch_to_local_data.sh
new file mode 100644
index 0000000..96edd94
--- /dev/null
+++ b/scripts/data/switch_to_local_data.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+# Verify a local ImageNet copy against the NAS folders, then atomically repoint the training
+# data symlinks (<data_dir>/train, <data_dir>/val) at it. Running jobs read the local copy from
+# their next file open: timm keeps the symlinked paths, so no restart is needed.
+# Nothing is switched if the file lists differ or a sampled file's content differs.
+#
+# Usage:
+#   bash scripts/data/switch_to_local_data.sh <local_root> <nas_train_dir> <nas_val_dir> [data_dir]
+#     local_root  directory holding train/ and val/ (e.g. /mnt/d/bench/imagenet)
+#     data_dir    folder with the train/val symlinks used as data_dir (default <project>/data/imagenet)
+#
+# Example (147):
+#   bash scripts/data/switch_to_local_data.sh /mnt/d/bench/imagenet \
+#     /mnt/a100b/default/wangjin/data/imagenet/train /mnt/a100b/default/wujiannan/data/imagenet-1k/val
+set -euo pipefail
+
+PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+LOCAL="$1"
+NAS_TRAIN="$2"
+NAS_VAL="$3"
+DATA_DIR="${4:-$PROJECT_ROOT/data/imagenet}"
+LISTS="$PROJECT_ROOT/logs/setup"
+mkdir -p "$LISTS"
+
+for split in train val; do
+  nas="$NAS_TRAIN"
+  [[ $split == val ]] && nas="$NAS_VAL"
+  (cd "$nas" && find . -type f | sort) > "$LISTS/nas_${split}_list.txt"
+  (cd "$LOCAL/$split" && find . -type f | sort) > "$LISTS/local_${split}_list.txt"
+  echo "$split: NAS $(wc -l < "$LISTS/nas_${split}_list.txt") files / local $(wc -l < "$LISTS/local_${split}_list.txt") files"
+  if ! cmp -s "$LISTS/nas_${split}_list.txt" "$LISTS/local_${split}_list.txt"; then
+    echo "[ERROR] $split file lists differ; not switching"
+    exit 1
+  fi
+  while read -r f; do
+    if ! cmp -s "$nas/$f" "$LOCAL/$split/$f"; then
+      echo "[ERROR] content differs: $split/$f; not switching"
+      exit 1
+    fi
+  done < <(shuf -n 200 "$LISTS/local_${split}_list.txt")
+done
+echo "file lists identical, 400 sampled files identical"
+
+cd "$DATA_DIR"
+for split in train val; do
+  ln -s "$LOCAL/$split" "$split.local"
+  mv -T "$split.local" "$split"
+done
+echo "[$(date '+%F %T')] switched $DATA_DIR to $LOCAL"
+ls -l "$DATA_DIR"
